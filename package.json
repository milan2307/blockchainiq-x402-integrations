{
  "name": "blockchainiq-x402-integrations",
  "version": "0.1.0",
  "description": "LangChain tool, Coinbase AgentKit action provider and Cloudflare Agents agent for Blockchain IQ's x402 pay-per-call crypto data API (USDC on Base).",
  "license": "MIT",
  "author": "LamuLabs",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:live-402": "LIVE_402=1 vitest run test/live-402.test.ts",
    "paid:langchain": "npm run build && node dist/examples/langchain-paid-call.js",
    "paid:agentkit": "npm run build && node dist/examples/agentkit-paid-call.js",
    "record-proofs": "npm run build && node dist/scripts/record-proofs.js",
    "paid:cloudflare": "npm --prefix cloudflare-agents run paid:cloudflare",
    "test:cloudflare": "npm --prefix cloudflare-agents test && npm --prefix cloudflare-agents run test:wrangler"
  },
  "dependencies": {
    "@coinbase/agentkit": "^0.10.4",
    "@langchain/core": "^1.3.0",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "reflect-metadata": "^0.2.2",
    "viem": "^2.38.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ]
}
